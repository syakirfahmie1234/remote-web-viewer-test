# ==============================================================================
# Remote Website Relay & Automation Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security (Never hardcode secrets in source code)
# ------------------------------------------------------------------------------
WORKER_TOKEN=change-me-to-a-strong-worker-secret
CONTROLLER_TOKEN=change-me-to-a-strong-controller-secret

# Optional: ACL mapping restricting controller tokens to specific worker_ids
# Format: "tokenA:worker-1,worker-2;tokenB:worker-3"
# If left empty, all authenticated controllers have access to all workers.
CONTROLLER_ALLOWED_WORKERS=

# Target Domain Authorization Restriction (Workers/Server restrict to this domain)
TARGET_DOMAIN=https://example.com

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
# Server bind port (Render dynamically provides PORT)
PORT=8000

# Session timeout in seconds for inactive controllers (0 = disabled, default: 3600)
SESSION_TIMEOUT_SECONDS=3600

# ------------------------------------------------------------------------------
# 3. Worker Configuration
# ------------------------------------------------------------------------------
# Stable Worker Identity (if left empty, worker auto-generates & stores in .worker_id)
WORKER_ID=

# Server WebSocket Endpoint
SERVER_WS_URL=ws://127.0.0.1:8000/ws/worker

# Browser Display Mode (true = headless, false = visible window)
HEADLESS=true

# Browser Viewport Resolution
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Browser Timeouts (seconds)
PAGE_LOAD_TIMEOUT=30.0
EXPLICIT_WAIT_TIMEOUT=10.0

# DOM Mutation Debounce Threshold (milliseconds)
MUTATION_DEBOUNCE_MS=100

# Optional Proxy Configuration
# PROXY_URL=socks5://127.0.0.1:1080
# PROXY_USERNAME=myuser
# PROXY_PASSWORD=mypass

# ------------------------------------------------------------------------------
# 4. Data Compression (Zstandard)
# ------------------------------------------------------------------------------
# Zstandard Compression Level (1-9, default: 3)
ZSTD_LEVEL=3

# Minimum payload size in bytes before Zstandard compression is applied (default: 1024)
ZSTD_THRESHOLD=1024
CONTROLLER_WS_URL=ws://127.0.0.1:8000/ws/controller

# Render deployment  set this to your Render service URL
SERVER_WS_URL=wss://your-service-name.onrender.com/ws/worker
CONTROLLER_WS_URL=wss://your-service-name.onrender.com/ws/controller
